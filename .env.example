# ─── Database ────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/baskhuji_dev"
# Unpooled connection, used only for migrations (Neon/Supabase poolers block advisory locks).
# Locally this is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/baskhuji_dev"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="generate-a-random-32-byte-hex-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── Gemini API (Google AI Studio — free tier, no billing required) ───────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# ─── Gmail API (agreement delivery, receipts, dispute & expiry notifications) ─
# Set up via: https://myaccount.google.com/apppasswords
GMAIL_EMAIL="noreply@baskhuji.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"

# ─── SSLCOMMERZ Sandbox (rent payments via bKash, Nagad, Rocket, card) ────────
# Register at: https://developer.sslcommerz.com
SSLCOMMERZ_STORE_ID="your-store-id"
SSLCOMMERZ_STORE_PASSWORD="your-store-password"

# ─── Scheduled reminders (Vacancy & Agreement Expiry Notification System) ────
# Shared secret for POST /api/cron/reminders — point an external scheduler
# (cron, Task Scheduler, a GitHub Action) at that route with this as the
# x-cron-secret header. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="generate-a-random-32-byte-hex-string"
